DOMAIN,mon-va.tiktokv.com,REJECT
DOMAIN,log.snssdk.com,REJECT
DOMAIN,mon.snssdk.com,REJECT

# ==============================================================================
# 4. Apple 廣告與指標遙測（不影響 iCloud、App Store、APNs 推播與證書驗證）
# ==============================================================================
DOMAIN,iadsdk.apple.com,REJECT
DOMAIN,metrics.icloud.com,REJECT
DOMAIN,metrics.mzstatic.com,REJECT
DOMAIN,securemetrics.apple.com,REJECT
DOMAIN,supportmetrics.apple.com,REJECT
DOMAIN,xp.apple.com,REJECT
